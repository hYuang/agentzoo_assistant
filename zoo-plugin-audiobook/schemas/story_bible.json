{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story bible",
  "type": "object",
  "properties": {
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "role": { "type": "string" },
          "age": { "type": "string" },
          "gender": { "type": "string" },
          "personality": { "type": "string" },
          "speech_style": { "type": "string" },
          "dialect": { "type": "string" },
          "voice_profile": { "type": "string" }
        }
      }
    },
    "world": { "type": "object" },
    "timeline": { "type": "array", "items": { "type": "object" } },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term"],
        "properties": {
          "term": { "type": "string" },
          "reading": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
