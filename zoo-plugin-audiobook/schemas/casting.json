{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audiobook casting",
  "type": "object",
  "properties": {
    "narrator": { "type": "string" },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "voice"],
        "properties": {
          "role": { "type": "string" },
          "voice": { "type": "string" },
          "speed": { "type": "number" },
          "style": { "type": "string" },
          "fallback": { "type": "string" }
        }
      }
    }
  }
}
