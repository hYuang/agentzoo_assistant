{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audiobook script line",
  "type": "object",
  "required": ["id", "text"],
  "properties": {
    "id": { "type": "string" },
    "chapter": { "type": "string" },
    "speaker": { "type": "string" },
    "lang": { "type": "string" },
    "tone": { "type": "string" },
    "dialect": { "type": "string" },
    "speed": { "type": "string" },
    "volume": { "type": "string" },
    "voice": { "type": "string" },
    "text": { "type": "string" }
  }
}
