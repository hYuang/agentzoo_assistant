{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audiobook asset index",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "path"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "path": { "type": "string" },
          "source": { "type": "string" },
          "license": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
