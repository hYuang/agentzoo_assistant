{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audiobook outline",
  "type": "object",
  "required": ["chapters"],
  "properties": {
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "scenes": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
