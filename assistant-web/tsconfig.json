{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@agentzoo/web-ui": ["../../agentzoo/zoo-web-ui/src/index.ts"],
      "@agentzoo/web-ui/global.css": ["../../agentzoo/zoo-web-ui/src/global.css"]
    }
  },
  "include": ["src"]
}
